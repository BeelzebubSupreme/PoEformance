# Normalize all text files to LF in the repository and CHECK THEM OUT AS LF too.
# eol=lf overrides a user's core.autocrlf=true, so Windows clones stop churning
# data/*.tsv (and every other text file) into CRLF on each pull.
* text=auto eol=lf

# Files that are intentionally CRLF — freeze them byte-for-byte (no EOL conversion).
# See CLAUDE.md "Line endings". -text disables normalization so they stay CRLF.
ahk/BridgeDispatch.ahk -text
ahk/WebViewBridge.ahk  -text
ui/animation_names.js  -text

# Version-carrying files: auto-resolve a version-line merge conflict to the higher
# version (the dev branch always wins). Needs the "poever" merge driver configured
# locally once — run tools/setup-git-merge-driver.sh (or .bat). See tools/git-merge-version.py.
InGameStateMonitor.ahk merge=poever
README.md              merge=poever
CLAUDE.md              merge=poever

# Binary assets — never normalize (text=auto already detects these; explicit for safety).
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.wav  binary
*.dll  binary
*.exe  binary
